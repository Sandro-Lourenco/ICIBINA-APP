# App
APP_ENV=development
APP_NAME=ICIBINA
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# PostgreSQL local role bootstrap
ICIBINA_OWNER_PASSWORD=change-me-owner
ICIBINA_APP_PASSWORD=change-me-app
ICIBINA_MIGRATOR_PASSWORD=change-me-migrator
ICIBINA_MCP_READER_PASSWORD=change-me-reader
DATABASE_URL=postgresql+asyncpg://icibina_app:change-me-app@localhost:5432/ICIBINA
DATABASE_MIGRATION_URL=postgresql+asyncpg://icibina_migrator:change-me-migrator@localhost:5432/ICIBINA
TEST_DATABASE_URL=postgresql+asyncpg://icibina_app:change-me-app@localhost:5432/ICIBINA_test
TEST_DATABASE_MIGRATION_URL=postgresql+asyncpg://icibina_migrator:change-me-migrator@localhost:5432/ICIBINA_test
TEST_MCP_DATABASE_URL=postgresql://icibina_mcp_reader:change-me-reader@localhost:5432/ICIBINA_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth - generate strong values; never reuse these in production
JWT_SECRET_KEY=CHANGE_ME_64_CHARS_MINIMUM_RANDOM
JWT_ISSUER=icibina
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Asaas SANDBOX - production uses https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=CHANGE_ME
ASAAS_WEBHOOK_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# S3-compatible storage / MinIO local baseline
MINIO_IMAGE=minio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=icibina
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=change-me-local
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/icibina

# Observability
OTEL_SERVICE_NAME=icibina-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# Operational
MAINTENANCE_MODE=false
